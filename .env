# Información de configuración de la base de datos para la App
# IMPORTANTE: El host debe coincidir con el nombre del servicio en el compose
DB_HOST=postgresql_JMB
DB_PORT=5432
DB_NAME=gobierno_recu_jmb
DB_USER=aaee_gobierno
DB_PASSWORD=1234

# Puerto externo para que DBeaver pueda conectar desde fuera
DB_PORT_EXT=2345

# Variables para que la imagen oficial de postgres:16 cree la base de datos
POSTGRES_DB=gobierno_recu_jmb
POSTGRES_USER=aaee_gobierno
POSTGRES_PASSWORD=1234

# Variables específicas para Spring Boot (Indispensables para la App)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql_xxx:5432/gobierno_recu_jmb
SPRING_DATASOURCE_USERNAME=aaee_gobierno
SPRING_DATASOURCE_PASSWORD=1234
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
